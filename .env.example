# Admin login. Set a long private value in Vercel. Never expose this publicly.
ADMIN_PASSWORD=change-me

# Upstash/Vercel KV REST storage for editable site content.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Blob storage for images, PDFs, documents, and PowerPoints.
# Add this in Vercel Project Settings > Environment Variables, or connect
# a Vercel Blob store to this project so Vercel creates the token for you.
# This value must remain server-only and must never use a VITE_ prefix.
BLOB_READ_WRITE_TOKEN=

# Optional public defaults for local Vite development only.
VITE_EDITOR_DEMO_MODE=true
